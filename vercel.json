{
  "version": 2,
  "builds": [
    {
      "src": "api/wechat-verification.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/blob-upload.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/97d81da2ce7a628eec9c0e69687925da.txt",
      "dest": "api/wechat-verification.js"
    },
    {
      "src": "/api/blob-upload/?",
      "dest": "api/blob-upload.js"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
